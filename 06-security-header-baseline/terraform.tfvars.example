subscription_id               = "<your-free-tier-subscription-id>"
location                      = "westeurope"
backend_fqdn                  = "app.example-lab.internal"
ssl_cert_key_vault_secret_id  = "https://kv-example-lab.vault.azure.net/secrets/appgw-cert/<version>"
content_security_policy       = "default-src 'self'; object-src 'none'; frame-ancestors 'self'"
