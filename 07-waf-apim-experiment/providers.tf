terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}
  # Auth comes from `az login` (Azure CLI) — no credentials are stored here.
  subscription_id = var.subscription_id
}
